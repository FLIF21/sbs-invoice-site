generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

enum PermissionKey {
  VIEW_DASHBOARD
  MANAGE_PRICING
  MANAGE_METAL
  MANAGE_COEFFICIENTS
  MANAGE_TAX
  MANAGE_COMPANY
  MANAGE_NUMBERING
  VIEW_INVOICES
  CREATE_INVOICES
  EDIT_INVOICES
  DELETE_INVOICES
  MANAGE_CLIENTS
  MANAGE_USERS
  VIEW_AUDIT
  MANAGE_BACKUPS
}

enum CalculationMethod {
  RECTANGULAR_DUCT
  RECTANGULAR_ELBOW
  RECTANGULAR_TRANSITION
  ROUND_DAMPER
  RECTANGULAR_DAMPER
  CUSTOM_AREA
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum BackupStatus {
  CREATED
  RESTORED
  FAILED
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String
  passwordHash String
  role         UserRole         @default(VIEWER)
  active       Boolean          @default(true)
  tokenVersion Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  permissions  UserPermission[]
  sessions     AuthSession[]
  invoices     Invoice[]        @relation("InvoiceCreator")
  auditLogs    AuditLog[]
  backups      BackupRecord[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
}

model UserPermission {
  id         String        @id @default(cuid())
  userId     String
  permission PermissionKey
  allowed    Boolean       @default(true)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
}

model AuthSession {
  id        String    @id @default(cuid())
  jti       String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  ipAddress  String
  successful Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

model Thickness {
  id          String        @id @default(cuid())
  code        String        @unique
  millimeters Decimal       @db.Decimal(4, 2)
  label       String
  active      Boolean       @default(true)
  sortOrder   Int           @default(0)
  metalPrice  MetalPrice?
  rates       ProductRate[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model MetalPrice {
  id                 String    @id @default(cuid())
  thicknessId        String    @unique
  costPerSquareMeter Decimal   @db.Decimal(18, 4)
  thickness          Thickness @relation(fields: [thicknessId], references: [id], onDelete: Restrict)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ProductType {
  id                String            @id @default(cuid())
  code              String            @unique
  name              String
  category          String
  description       String?
  imagePath         String?
  defaultDimensions Json
  calculationMethod CalculationMethod
  active            Boolean           @default(true)
  sortOrder         Int               @default(0)
  rates             ProductRate[]
  invoiceItems      InvoiceItem[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model ProductRate {
  id                 String      @id @default(cuid())
  productTypeId      String
  thicknessId        String
  tierKey            String      @default("default")
  minBoundary        Decimal?    @db.Decimal(18, 4)
  maxBoundary        Decimal?    @db.Decimal(18, 4)
  materialMultiplier Decimal     @default(1) @db.Decimal(18, 6)
  laborCost          Decimal     @default(0) @db.Decimal(18, 4)
  active             Boolean     @default(true)
  productType        ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  thickness          Thickness   @relation(fields: [thicknessId], references: [id], onDelete: Restrict)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([productTypeId, thicknessId, tierKey])
  @@index([productTypeId, thicknessId, minBoundary, maxBoundary])
}

model Coefficient {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  value       Decimal  @default(1) @db.Decimal(12, 6)
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TaxSetting {
  id        String   @id @default("default")
  enabled   Boolean  @default(true)
  rate      Decimal  @default(20) @db.Decimal(6, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyProfile {
  id            String   @id @default("default")
  name          String
  legalName     String
  inn           String?
  kpp           String?
  ogrn          String?
  bankName      String?
  bik           String?
  checking      String?
  correspondent String?
  address       String?
  phone         String?
  email         String?
  website       String?
  logo          Bytes?
  logoMimeType  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InvoiceNumberSetting {
  id          String   @id @default("default")
  pattern     String   @default("{NUMBER:6}")
  nextValue   Int      @default(1)
  resetYearly Boolean  @default(false)
  lastYear    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id        String    @id @default(cuid())
  name      String
  inn       String?   @unique
  kpp       String?
  address   String?
  phone     String?
  email     String?
  notes     String?
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
  @@index([createdAt])
}

model Invoice {
  id              String        @id @default(cuid())
  number          String        @unique
  status          InvoiceStatus @default(ISSUED)
  issueDate       DateTime      @default(now())
  dueDate         DateTime?
  project         String?
  requestNumber   String?
  applicant       String?
  notes           String?
  currency        String        @default("RUB")
  clientId        String?
  createdById     String?
  subtotal        Decimal       @db.Decimal(18, 2)
  taxAmount       Decimal       @db.Decimal(18, 2)
  total           Decimal       @db.Decimal(18, 2)
  clientSnapshot  Json
  companySnapshot Json
  pricingSnapshot Json
  taxSnapshot     Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  client          Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy       User?         @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items           InvoiceItem[]

  @@index([status, issueDate])
  @@index([clientId, issueDate])
  @@index([createdById, createdAt])
  @@index([createdAt])
}

model InvoiceItem {
  id                  String       @id @default(cuid())
  invoiceId           String
  productTypeId       String?
  position            Int
  productCodeSnapshot String
  description         String
  dimensions          Json
  thicknessCode       String
  quantity            Decimal      @db.Decimal(18, 3)
  area                Decimal      @db.Decimal(18, 4)
  unitPrice           Decimal      @db.Decimal(18, 4)
  total               Decimal      @db.Decimal(18, 2)
  invoice             Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productType         ProductType? @relation(fields: [productTypeId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, position])
  @@index([productTypeId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model BackupRecord {
  id          String       @id @default(cuid())
  fileName    String
  checksum    String
  size        Int
  status      BackupStatus @default(CREATED)
  createdById String?
  createdAt   DateTime     @default(now())
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model SystemSetting {
  key         String   @id
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
